# Environment variables — copy to .env and fill in values

# Database — use SQLite for local dev, MySQL for production
DATABASE_URL="file:./dev.db"
# For MySQL (production / Docker):
# DATABASE_URL="mysql://root:password@localhost:3306/grievance_db"

# JWT — generate a strong random secret
JWT_SECRET="change-me-to-a-long-random-secret-string"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Email (leave blank to use console fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LAW CENTRE II Grievance Portal <noreply@lc2.du.ac.in>"

# Meta WhatsApp Cloud API Configuration
# Get from Meta Developers Portal (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-permanent-or-system-user-access-token"
WHATSAPP_VERIFY_TOKEN="lc2_grievance_bot_verify_token_2026"
