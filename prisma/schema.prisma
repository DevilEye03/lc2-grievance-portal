// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Role, ComplaintStatus, and Category values are stored as String fields.
// Valid values are enforced at the application layer (Zod validations).

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OFFICER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id             String    @id @default(uuid())
  ticketId       String    @unique
  studentName    String
  studentRoll    String
  studentEmail   String
  studentPhone   String?
  category       String
  subject        String
  description    String    @db.Text
  attachmentUrl  String?   @db.MediumText
  status         String    @default("REGISTERED")
  assignedTo     String?
  authorityReply String?   @db.Text
  repliedAt      DateTime?
  ackDueDate     DateTime
  slaDueDate     DateTime
  source         String    @default("WEB")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  statusLogs StatusLog[]

  @@index([ticketId])
  @@index([studentEmail])
  @@index([status])
}

model StatusLog {
  id          String   @id @default(uuid())
  complaintId String
  status      String
  comment     String?  @db.Text
  changedBy   String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model WhatsAppSession {
  id         String   @id @default(uuid())
  phone      String   @unique
  step       String   @default("IDLE")
  tempData   String   @db.Text
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([phone])
}
